---
import '../../styles/fonts.css';
import '../../styles/styles.css';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Play Trace, a classic snake game built into Oren." />
  <title>Trace — Oren</title>
  <link rel="icon" type="image/png" href="/oren-logo.png" />
  <style>
    .game-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding-bottom: 40px;
    }
    .game-header {
      text-align: center;
      margin-bottom: 24px;
      width: 100%;
      max-width: 400px;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .game-title {
      font-family: 'Newsreader', serif;
      font-style: italic;
      font-size: 2.5rem;
      color: var(--text-base);
      margin-bottom: 8px;
    }
    .game-score {
      font-family: 'Inter', sans-serif;
      font-size: 1rem;
      color: var(--accent);
      font-weight: 500;
    }
    .canvas-wrapper {
      position: relative;
      background-color: var(--surface-2);
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    }
    canvas {
      display: block;
      outline: none;
    }
    .overlay {
      position: absolute;
      inset: 0;
      background: rgba(var(--surface-1-rgb), 0.9);
      backdrop-filter: blur(4px);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
      text-align: center;
    }
    .overlay.active {
      opacity: 1;
      pointer-events: auto;
    }
    .overlay h2 {
      font-family: 'Newsreader', serif;
      font-size: 2rem;
      color: var(--text-base);
      margin-bottom: 8px;
      font-style: italic;
    }
    .overlay p {
      font-family: 'Inter', sans-serif;
      color: var(--text-muted);
      margin-bottom: 24px;
    }
    .controls {
      display: grid;
      grid-template-columns: repeat(3, 50px);
      gap: 10px;
      margin-top: 24px;
    }
    .controls button {
      height: 50px;
      border-radius: 8px;
      border: 1px solid var(--border);
      background: var(--surface-2);
      color: var(--text-base);
      font-size: 1.2rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .controls button:active { background: var(--surface-3); }
    .controls .up { grid-column: 2; grid-row: 1; }
    .controls .left { grid-column: 1; grid-row: 2; }
    .controls .down { grid-column: 2; grid-row: 2; }
    .controls .right { grid-column: 3; grid-row: 2; }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: var(--text-muted);
      text-decoration: none;
      font-family: 'Inter', sans-serif;
      font-size: 0.875rem;
      margin-bottom: 24px;
      transition: color 0.2s;
    }
    .back-link:hover { color: var(--accent); }
  </style>
</head>
<body class="game-page">

<!-- NAVBAR -->
<nav class="navbar" id="navbar">
  <a href="/" class="nav-brand">
    <img src="/oren-logo.svg" alt="Oren logo" class="nav-logo" />
    <span class="nav-wordmark">Oren</span>
  </a>
  <div class="nav-links" id="nav-links">
    <a href="/features" class="nav-link">Features</a>
    <a href="/#themes" class="nav-link">Themes</a>
    <a href="/games" class="nav-link">Games</a>
    <a href="/#download" class="nav-cta">Download</a>
  </div>
  <button class="hamburger" id="hamburger" aria-label="Menu">
    <span></span><span></span><span></span>
  </button>
</nav>

<main class="section" style="padding-top: 100px;">
  <div class="section-inner section-center">
    <a href="/games" class="back-link">&larr; Back to Games</a>
    
    <div class="game-container fade-up">
      <div class="game-header">
        <h1 class="game-title">Trace</h1>
        <div class="game-score">Score: <span id="score">0</span></div>
      </div>
      
      <div class="canvas-wrapper">
        <canvas id="gameCanvas" width="400" height="400"></canvas>
        <div class="overlay" id="overlay">
          <h2 id="overlay-title">Game Over</h2>
          <p id="overlay-desc">You traced too far.</p>
          <button class="btn-primary" id="restart-btn">Play Again</button>
        </div>
      </div>

      <!-- Mobile controls, visible only on small screens via CSS usually, but we'll show always for simplicity or handle via media query. Let's hide on desktop. -->
      <style>
        @media (min-width: 768px) { .controls { display: none; } }
      </style>
      <div class="controls">
        <button class="up" id="btn-up">↑</button>
        <button class="left" id="btn-left">←</button>
        <button class="down" id="btn-down">↓</button>
        <button class="right" id="btn-right">→</button>
      </div>

    </div>
  </div>
</main>

<script>
  // Navbar logic
  const navbar = document.getElementById('navbar');
  window.addEventListener('scroll', () => navbar.classList.toggle('scrolled', window.scrollY > 20), { passive: true });
  document.querySelectorAll('.fade-up').forEach(el => el.classList.add('visible'));

  const canvas = document.getElementById('gameCanvas');
  const ctx = canvas.getContext('2d');
  const scoreEl = document.getElementById('score');
  const overlay = document.getElementById('overlay');
  const restartBtn = document.getElementById('restart-btn');
  const overlayTitle = document.getElementById('overlay-title');
  const overlayDesc = document.getElementById('overlay-desc');

  // Colors from theme (fallback to hardcoded if css vars not ready)
  const style = getComputedStyle(document.body);
  const getVar = (name, fb) => style.getPropertyValue(name).trim() || fb;
  
  const gridSize = 20;
  const tileCount = canvas.width / gridSize;

  let snake = [];
  let dx = 0;
  let dy = 0;
  let foodX = 0;
  let foodY = 0;
  let score = 0;
  let gameLoop;
  let speed = 100;

  function initGame() {
    snake = [
      {x: 10, y: 10},
      {x: 10, y: 11},
      {x: 10, y: 12},
    ];
    dx = 0;
    dy = -1;
    score = 0;
    speed = 120;
    scoreEl.textContent = score;
    overlay.classList.remove('active');
    placeFood();
    if(gameLoop) clearTimeout(gameLoop);
    tick();
  }

  function placeFood() {
    foodX = Math.floor(Math.random() * tileCount);
    foodY = Math.floor(Math.random() * tileCount);
    // ensure not on snake
    for (let part of snake) {
      if (part.x === foodX && part.y === foodY) {
        placeFood();
        return;
      }
    }
  }

  function draw() {
    const bg = getVar('--surface-2', '#1a1a1a');
    const accent = getVar('--accent', '#f74b0d');
    const textBase = getVar('--text-base', '#fff');

    // Bg
    ctx.fillStyle = bg;
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    // Food
    ctx.fillStyle = accent;
    ctx.beginPath();
    ctx.arc(foodX * gridSize + gridSize/2, foodY * gridSize + gridSize/2, gridSize/2 - 2, 0, Math.PI*2);
    ctx.fill();

    // Snake
    snake.forEach((part, index) => {
      // gradient opacity or size for head? 
      ctx.fillStyle = index === 0 ? textBase : getVar('--text-muted', '#888');
      
      // smooth corners
      ctx.fillRect(part.x * gridSize + 1, part.y * gridSize + 1, gridSize - 2, gridSize - 2);
    });
  }

  function update() {
    const head = { x: snake[0].x + dx, y: snake[0].y + dy };

    // Walls
    if (head.x < 0 || head.x >= tileCount || head.y < 0 || head.y >= tileCount) {
      gameOver();
      return;
    }

    // Self
    for (let part of snake) {
      if (part.x === head.x && part.y === head.y) {
        gameOver();
        return;
      }
    }

    snake.unshift(head);

    // Food
    if (head.x === foodX && head.y === foodY) {
      score += 10;
      scoreEl.textContent = score;
      if (speed > 50) speed -= 2;
      placeFood();
    } else {
      snake.pop();
    }
  }

  function gameOver() {
    clearTimeout(gameLoop);
    overlayTitle.textContent = "Game Over";
    overlayDesc.textContent = `You scored ${score} points.`;
    overlay.classList.add('active');
  }

  function tick() {
    update();
    draw();
    if (!overlay.classList.contains('active')) {
      gameLoop = setTimeout(tick, speed);
    }
  }

  function changeDirection(newDx, newDy) {
    // prevent reverse
    if (dx !== 0 && newDx !== 0) return;
    if (dy !== 0 && newDy !== 0) return;
    dx = newDx;
    dy = newDy;
  }

  window.addEventListener('keydown', e => {
    switch(e.key) {
      case 'ArrowUp': case 'w': changeDirection(0, -1); e.preventDefault(); break;
      case 'ArrowDown': case 's': changeDirection(0, 1); e.preventDefault(); break;
      case 'ArrowLeft': case 'a': changeDirection(-1, 0); e.preventDefault(); break;
      case 'ArrowRight': case 'd': changeDirection(1, 0); e.preventDefault(); break;
    }
  });

  document.getElementById('btn-up').addEventListener('click', () => changeDirection(0, -1));
  document.getElementById('btn-down').addEventListener('click', () => changeDirection(0, 1));
  document.getElementById('btn-left').addEventListener('click', () => changeDirection(-1, 0));
  document.getElementById('btn-right').addEventListener('click', () => changeDirection(1, 0));

  restartBtn.addEventListener('click', initGame);

  // Initial draw before start?
  // Let's just show start screen
  overlayTitle.textContent = "Trace";
  overlayDesc.textContent = "Use arrow keys to move.";
  restartBtn.textContent = "Start Game";
  overlay.classList.add('active');
  
  // Quick pre-draw
  snake = [{x:10,y:10}];
  foodX = -10;
  draw();

</script>

</body>
</html>
