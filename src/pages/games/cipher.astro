---
import '../../styles/fonts.css';
import '../../styles/styles.css';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Play Cipher, a daily word puzzle game built into Oren." />
  <title>Cipher — Oren</title>
  <link rel="icon" type="image/png" href="/oren-logo.png" />
  <style>
    .game-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 70vh;
      padding-bottom: 40px;
    }
    .game-header {
      text-align: center;
      margin-bottom: 24px;
    }
    .game-title {
      font-family: 'Newsreader', serif;
      font-style: italic;
      font-size: 2.5rem;
      color: var(--text-base);
      margin-bottom: 4px;
    }
    .game-status {
      font-family: 'Inter', sans-serif;
      font-size: 0.875rem;
      color: var(--text-muted);
      height: 20px;
    }
    .board {
      display: grid;
      grid-template-rows: repeat(6, 1fr);
      gap: 5px;
      margin-bottom: 32px;
    }
    .row {
      display: grid;
      grid-template-columns: repeat(5, 50px);
      gap: 5px;
    }
    @media (max-width: 400px) {
      .row { grid-template-columns: repeat(5, 12vw); }
    }
    .cell {
      aspect-ratio: 1;
      border: 2px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      font-weight: bold;
      color: var(--text-base);
      text-transform: uppercase;
      font-family: 'Inter', sans-serif;
      transition: all 0.3s ease;
    }
    .cell.filled {
      border-color: var(--text-muted);
      animation: popIn 0.1s;
    }
    .cell.correct {
      background-color: #538d4e;
      border-color: #538d4e;
      color: white;
    }
    .cell.present {
      background-color: #b59f3b;
      border-color: #b59f3b;
      color: white;
    }
    .cell.absent {
      background-color: var(--surface-3);
      border-color: var(--surface-3);
      color: var(--text-muted);
    }
    @keyframes popIn {
      0% { transform: scale(0.8); }
      40% { transform: scale(1.1); }
      100% { transform: scale(1); }
    }
    
    .keyboard {
      display: flex;
      flex-direction: column;
      gap: 8px;
      width: 100%;
      max-width: 500px;
    }
    .kbd-row {
      display: flex;
      justify-content: center;
      gap: 6px;
    }
    .key {
      background-color: var(--surface-2);
      border: none;
      border-radius: 4px;
      height: 58px;
      min-width: 40px;
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Inter', sans-serif;
      font-size: 1rem;
      font-weight: 500;
      color: var(--text-base);
      cursor: pointer;
      text-transform: uppercase;
      transition: background-color 0.2s;
      user-select: none;
    }
    .key:active { transform: scale(0.95); }
    .key.large { flex: 1.5; font-size: 0.8rem; }
    
    .key.correct { background-color: #538d4e; color: white; }
    .key.present { background-color: #b59f3b; color: white; }
    .key.absent { background-color: var(--surface-3); color: var(--text-muted); opacity: 0.5; }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: var(--text-muted);
      text-decoration: none;
      font-family: 'Inter', sans-serif;
      font-size: 0.875rem;
      margin-bottom: 24px;
      transition: color 0.2s;
    }
    .back-link:hover { color: var(--accent); }
    
    .toast {
      position: fixed;
      top: 100px;
      left: 50%;
      transform: translateX(-50%);
      background: var(--text-primary);
      color: var(--bg);
      padding: 12px 24px;
      border-radius: 8px;
      font-family: 'Inter', sans-serif;
      font-weight: 500;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
      z-index: 100;
    }
    .toast.show { opacity: 1; }
  </style>
</head>
<body class="game-page">

<!-- NAVBAR -->
<nav class="navbar" id="navbar">
  <a href="/" class="nav-brand">
    <img src="/oren-logo.svg" alt="Oren logo" class="nav-logo" />
    <span class="nav-wordmark">Oren</span>
  </a>
  <div class="nav-links" id="nav-links">
    <a href="/features" class="nav-link">Features</a>
    <a href="/#themes" class="nav-link">Themes</a>
    <a href="/games" class="nav-link">Games</a>
    <a href="/#download" class="nav-cta">Download</a>
  </div>
  <button class="hamburger" id="hamburger" aria-label="Menu">
    <span></span><span></span><span></span>
  </button>
</nav>

<div class="toast" id="toast">Not enough letters</div>

<main class="section" style="padding-top: 100px;">
  <div class="section-inner section-center">
    <a href="/games" class="back-link">&larr; Back to Games</a>
    
    <div class="game-container fade-up">
      <div class="game-header">
        <h1 class="game-title">Cipher</h1>
        <div class="game-status" id="status">Guess the daily word.</div>
      </div>
      
      <div class="board" id="board">
        <!-- 6 rows, 5 cells each -->
      </div>

      <div class="keyboard" id="keyboard">
        <div class="kbd-row">
          <button class="key" data-key="q">q</button><button class="key" data-key="w">w</button><button class="key" data-key="e">e</button><button class="key" data-key="r">r</button><button class="key" data-key="t">t</button><button class="key" data-key="y">y</button><button class="key" data-key="u">u</button><button class="key" data-key="i">i</button><button class="key" data-key="o">o</button><button class="key" data-key="p">p</button>
        </div>
        <div class="kbd-row">
          <button class="key" data-key="a">a</button><button class="key" data-key="s">s</button><button class="key" data-key="d">d</button><button class="key" data-key="f">f</button><button class="key" data-key="g">g</button><button class="key" data-key="h">h</button><button class="key" data-key="j">j</button><button class="key" data-key="k">k</button><button class="key" data-key="l">l</button>
        </div>
        <div class="kbd-row">
          <button class="key large" data-key="enter">ENTER</button><button class="key" data-key="z">z</button><button class="key" data-key="x">x</button><button class="key" data-key="c">c</button><button class="key" data-key="v">v</button><button class="key" data-key="b">b</button><button class="key" data-key="n">n</button><button class="key" data-key="m">m</button><button class="key large" data-key="backspace">DEL</button>
        </div>
      </div>
    </div>
  </div>
</main>

<script>
  // Navbar fade-up logic
  const navbar = document.getElementById('navbar');
  window.addEventListener('scroll', () => navbar.classList.toggle('scrolled', window.scrollY > 20), { passive: true });
  document.querySelectorAll('.fade-up').forEach(el => el.classList.add('visible'));

  // Words list (compressed common 5-letter words)
  const WORDS = ["about","above","abuse","actor","acute","admit","adopt","adult","after","again","agent","agree","ahead","alarm","album","alert","alike","alive","allow","alone","along","alter","among","anger","angle","angry","apart","apple","apply","arena","argue","arise","array","aside","asset","audio","audit","avoid","award","aware","badly","baker","bases","basic","basis","beach","began","begin","begun","being","below","bench","billy","birth","black","blame","blind","block","blood","board","boost","booth","bound","brain","brand","bread","break","breed","brief","bring","broad","broke","brown","build","built","buyer","cable","calif","carry","catch","cause","chain","chair","chart","chase","cheap","check","chest","chief","child","china","chose","civil","claim","class","clean","clear","click","clock","close","coach","coast","could","count","court","cover","craft","crash","cream","crime","cross","crowd","crown","curve","cycle","daily","dance","dated","dealt","death","debut","delay","depth","doing","doubt","dozen","draft","drama","drawn","dream","dress","drill","drink","drive","drove","dying","eager","early","earth","eight","elite","empty","enemy","enjoy","enter","entry","equal","error","event","every","exact","exist","extra","faith","false","fault","fiber","field","fifth","fifty","fight","final","first","fixed","flash","fleet","floor","fluid","focus","force","forth","forty","forum","found","frame","frank","fraud","fresh","front","fruit","fully","funny","giant","given","glass","globe","going","grace","grade","grand","grant","grass","great","green","gross","group","grown","guard","guess","guest","guide","happy","harry","heart","heavy","hence","night","horse","hotel","house","human","ideal","image","index","inner","input","issue","japan","joint","jones","judge","known","label","large","laser","later","laugh","layer","learn","lease","least","leave","legal","level","lewis","light","limit","links","lives","local","logic","loose","lower","lucky","lunch","lying","magic","major","maker","march","maria","match","mayor","meant","media","metal","might","minor","minus","mixed","model","money","month","moral","motor","mount","mouse","mouth","movie","music","needs","never","newly","night","noise","north","noted","novel","nurse","occur","ocean","offer","often","order","other","ought","paint","panel","paper","party","peace","peter","phase","phone","photo","piece","pilot","pitch","place","plain","plane","plant","plate","point","pound","power","press","price","pride","prime","print","prior","prize","proof","proud","prove","queen","quick","quiet","quite","radio","raise","range","rapid","ratio","reach","ready","refer","right","rival","river","robin","robot","rough","round","route","royal","rural","scale","scene","scope","score","sense","serve","seven","shall","shape","share","sharp","sheet","shelf","shell","shift","shirt","shock","shoot","short","shown","sight","since","sixth","sixty","sized","skill","sleep","slide","small","smart","smile","smith","smoke","solid","solve","sorry","sound","south","space","spare","speak","speed","spend","spent","split","spoke","sport","staff","stage","stake","stand","start","state","steam","steel","stick","still","stock","stone","stood","store","storm","story","strip","stuck","study","stuff","style","sugar","suite","super","sweet","table","taken","taste","taxes","teach","teeth","terry","texas","thank","theft","their","theme","there","these","thick","thing","think","third","thirty","those","three","threw","throw","tight","times","tired","title","today","topic","total","touch","tough","tower","track","trade","train","treat","trend","trial","tried","tries","truck","truly","trust","truth","twice","under","undue","union","unity","until","upper","upset","urban","usage","usual","valid","value","video","virus","visit","vital","voice","watch","water","wheel","where","which","while","white","whole","whose","woman","women","world","worry","worse","worst","worth","would","wound","write","wrong","wrote","yield","young","youth"];

  // Logic
  const boardEl = document.getElementById('board');
  const statusEl = document.getElementById('status');
  const toastEl = document.getElementById('toast');
  const keyboardBtns = document.querySelectorAll('.key');

  const today = Math.floor(Date.now() / 86400000);
  // Simple seeded hash to pick a word
  let hash = 0;
  let t = today.toString();
  for (let i = 0; i < t.length; i++) hash = ((hash << 5) - hash) + t.charCodeAt(i);
  const wordIndex = Math.abs(hash) % WORDS.length;
  const targetWord = WORDS[wordIndex].toUpperCase();

  let guesses = [];
  let currentGuess = "";
  let gameOver = false;

  // Init board
  for (let r = 0; r < 6; r++) {
    const row = document.createElement('div');
    row.className = 'row';
    for (let c = 0; c < 5; c++) {
      const cell = document.createElement('div');
      cell.className = 'cell';
      cell.id = `cell-${r}-${c}`;
      row.appendChild(cell);
    }
    boardEl.appendChild(row);
  }

  // Load state
  const savedState = JSON.parse(localStorage.getItem('oren_cipher_state'));
  if (savedState && savedState.date === today) {
    guesses = savedState.guesses || [];
    guesses.forEach((guess, i) => {
      currentGuess = guess;
      updateBoardRow(i);
      evaluateRow(i, true);
    });
    currentGuess = "";
    if (guesses.includes(targetWord)) gameOver = true;
    if (guesses.length >= 6) gameOver = true;
  }

  function saveState() {
    localStorage.setItem('oren_cipher_state', JSON.stringify({ date: today, guesses }));
  }

  function showToast(msg) {
    toastEl.textContent = msg;
    toastEl.classList.add('show');
    setTimeout(() => toastEl.classList.remove('show'), 2000);
  }

  function updateBoardRow(r) {
    for (let c = 0; c < 5; c++) {
      const cell = document.getElementById(`cell-${r}-${c}`);
      const letter = currentGuess[c];
      cell.textContent = letter || "";
      if (letter) cell.classList.add('filled');
      else cell.classList.remove('filled');
    }
  }

  function updateKeyboard(letter, status) {
    const btn = document.querySelector(`.key[data-key="${letter.toLowerCase()}"]`);
    if (!btn) return;
    if (status === 'correct') {
      btn.classList.remove('present', 'absent');
      btn.classList.add('correct');
    } else if (status === 'present' && !btn.classList.contains('correct')) {
      btn.classList.remove('absent');
      btn.classList.add('present');
    } else if (status === 'absent' && !btn.classList.contains('correct') && !btn.classList.contains('present')) {
      btn.classList.add('absent');
    }
  }

  function evaluateRow(r, isLoad = false) {
    const guess = isLoad ? guesses[r] : currentGuess;
    const targetArr = targetWord.split('');
    const guessArr = guess.split('');
    const results = Array(5).fill('absent');

    // First pass: correct
    for (let i = 0; i < 5; i++) {
      if (guessArr[i] === targetArr[i]) {
        results[i] = 'correct';
        targetArr[i] = null;
      }
    }
    // Second pass: present
    for (let i = 0; i < 5; i++) {
      if (results[i] !== 'correct' && targetArr.includes(guessArr[i])) {
        results[i] = 'present';
        targetArr[targetArr.indexOf(guessArr[i])] = null;
      }
    }

    // Apply classes
    for (let i = 0; i < 5; i++) {
      const cell = document.getElementById(`cell-${r}-${i}`);
      setTimeout(() => {
        cell.classList.add(results[i]);
        updateKeyboard(guessArr[i], results[i]);
      }, isLoad ? 0 : i * 200);
    }

    if (!isLoad) {
      setTimeout(() => {
        if (guess === targetWord) {
          showToast("Genius!");
          statusEl.textContent = "You got it!";
          gameOver = true;
        } else if (guesses.length === 6) {
          showToast(targetWord);
          statusEl.textContent = `The word was ${targetWord}`;
          gameOver = true;
        }
      }, 1000);
    }
  }

  function handleKey(key) {
    if (gameOver) return;

    if (key === 'enter') {
      if (currentGuess.length < 5) {
        showToast("Not enough letters");
        return;
      }
      if (!WORDS.includes(currentGuess.toLowerCase())) {
        showToast("Not in word list");
        return;
      }
      evaluateRow(guesses.length);
      guesses.push(currentGuess);
      saveState();
      currentGuess = "";
    } else if (key === 'backspace') {
      currentGuess = currentGuess.slice(0, -1);
      updateBoardRow(guesses.length);
    } else if (/^[a-z]$/.test(key)) {
      if (currentGuess.length < 5) {
        currentGuess += key.toUpperCase();
        updateBoardRow(guesses.length);
      }
    }
  }

  window.addEventListener('keydown', e => {
    if (e.ctrlKey || e.metaKey || e.altKey) return;
    const key = e.key.toLowerCase();
    if (key === 'enter' || key === 'backspace' || /^[a-z]$/.test(key)) {
      handleKey(key);
    }
  });

  keyboardBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      handleKey(btn.dataset.key);
      btn.blur();
    });
  });

</script>

</body>
</html>
