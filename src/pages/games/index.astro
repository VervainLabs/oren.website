---
import '../../styles/fonts.css';
import '../../styles/styles.css';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Take a break with Oren's built-in mini games. Play Nought, Cipher, Trace, and Wreck." />
  <title>Games — Oren</title>
  <link rel="icon" type="image/png" href="/oren-logo.png" />
</head>
<body class="games-page">

<!-- NAVBAR -->
<nav class="navbar" id="navbar">
  <a href="/" class="nav-brand">
    <img src="/oren-logo.png" alt="Oren logo" class="nav-logo" />
    <span class="nav-wordmark">Oren</span>
  </a>
  <div class="nav-links" id="nav-links">
    <a href="/features" class="nav-link">Features</a>
    <a href="/#themes" class="nav-link">Themes</a>
    <a href="/games" class="nav-link">Games</a>
    <a href="/#download" class="nav-cta">Download</a>
  </div>
  <button class="hamburger" id="hamburger" aria-label="Menu">
    <span></span><span></span><span></span>
  </button>
</nav>
<div class="mobile-menu" id="mobile-menu">
  <a href="/features" class="nav-link">Features</a>
  <a href="/#themes" class="nav-link">Themes</a>
  <a href="/games" class="nav-link">Games</a>
  <a href="/#download" class="nav-cta">Download</a>
</div>

<!-- HEADER -->
<header class="section-center" style="padding-top: 140px; padding-bottom: 60px;">
  <span class="section-label fade-up">Built-in Games</span>
  <h1 class="section-heading fade-up" style="font-size: var(--text-hero); line-height: 1.1; margin-bottom: 24px;">Take a break.</h1>
  <p class="section-sub fade-up" style="margin-bottom: 0;">Rest your brain before getting back to work.</p>
</header>

<main class="section" style="padding-top: 0; min-height: 50vh;">
  <div class="section-inner section-center">
    <div class="games-grid">
      
      <a href="/games/nought" class="game-card fade-up" style="--i:0; text-decoration: none; color: inherit;">
        <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:16px;">
          <span class="game-badge">Classic</span>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="3" y1="15" x2="21" y2="15"></line><line x1="9" y1="3" x2="9" y2="21"></line><line x1="15" y1="3" x2="15" y2="21"></line></svg>
        </div>
        <div class="game-name">Nought</div>
        <p class="game-desc">The oldest argument on paper. Tic Tac Toe with animations.</p>
      </a>

      <a href="/games/trace" class="game-card fade-up" style="--i:1; text-decoration: none; color: inherit;">
        <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:16px;">
          <span class="game-badge">Arcade</span>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 16c1.5 0 2-2 4-2s2 2 4 2 2-2 4-2 2 2 4 2" stroke-dasharray="4 4"></path><circle cx="20" cy="16" r="1"></circle></svg>
        </div>
        <div class="game-name">Trace</div>
        <p class="game-desc">Classic snake game with a modern UI. Simple to start, hard to stop.</p>
      </a>

      <a href="/games/wreck" class="game-card fade-up" style="--i:2; text-decoration: none; color: inherit;">
        <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:16px;">
          <span class="game-badge">Arcade</span>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="4"></rect><path d="M12 12v6"></path><circle cx="12" cy="18" r="2"></circle></svg>
        </div>
        <div class="game-name">Wreck</div>
        <p class="game-desc">A wall of bricks. A single ball. Break everything before it hits the floor.</p>
      </a>

    </div>
    <br /> <br />
    <p> <i>More games cooking in progress... arriving soon...</i> </p>

  </div>
</main>

<!-- FOOTER -->
<footer class="footer">
  <div class="footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <div class="footer-brand-logo">
          <img src="/oren-logo.png" alt="Oren" class="footer-logo" />
          <span class="footer-wordmark">Oren</span>
        </div>
        <p class="footer-tagline">Built by Vervain Labs</p>
      </div>
      <div class="footer-col">
        <div class="footer-col-title">Product</div>
        <a href="/features">Features</a>
        <a href="/#themes">Themes</a>
        <a href="/#download">Download</a>
        <a href="#">Changelog</a>
      </div>
      <div class="footer-col">
        <div class="footer-col-title">Vervain Labs</div>
        <a href="https://vervain-labs.vercel.app/" target="_blank" rel="noopener noreferrer">About</a>
        <a href="https://github.com/VervainLabs/oren.main" target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
      <div class="footer-col">
        <div class="footer-col-title">Legal</div>
        <a href="/privacy">Privacy Policy</a>
        <a href="#">MIT License</a>
      </div>
    </div>
    <div class="footer-bottom">&copy; 2026 Vervain Labs &nbsp;&middot;&nbsp; Oren is free and open source</div>
  </div>
</footer>

<script>
  // Navbar & fade-up
  const navbar = document.getElementById('navbar');
  window.addEventListener('scroll', () => navbar.classList.toggle('scrolled', window.scrollY > 20), { passive: true });
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) { entry.target.classList.add('visible'); observer.unobserve(entry.target); }
    });
  }, { threshold: 0.08 });
  document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));
</script>

</body>
</html>
